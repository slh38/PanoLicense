# PanoLicense API ortam ayarları şablonu.
# Gerçek değerler .env dosyasındadır ve repoya girmez.

APP_NAME=PanoLicense
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# MySQL 8 (cPanel'de ad/kullanıcı "cpanelkullanici_panolicense" biçimindedir)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panolicense_dev
DB_USERNAME=panolicense
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Panel oturumu: Sanctum SPA (aynı domain, HttpOnly cookie)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000
# Canlıda: SANCTUM_STATEFUL_DOMAINS=lisans.jokeryazilim.com.tr ve SESSION_SECURE_COOKIE=true

# Cloudflare vb. arkasındaysa onun IP aralıkları (virgülle). Boş = proxy'ye güvenilmez.
TRUSTED_PROXIES=

# Paylaşımlı hosting: Redis ve queue worker yok
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="lisans@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Lisans imzası (F3). Özel anahtar yalnız sunucuda ve public dizini DIŞINDA tutulur.
# LICENSE_SIGNING_KEY_PATH=/home/cpanelkullanici/panolicense-keys/ed25519.key
# LICENSE_SIGNING_KEY_ID=k1
LICENSE_OFFLINE_GRACE_DAYS=7
